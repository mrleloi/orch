# Dockerfile.core — Orch daemon (packages/core)
#
# Build context: repo root (docker-compose.yml `context: .`)
# Image: node:20-slim  (Debian slim; curl available via apt-get for HEALTHCHECK)
#
# Multi-stage:
#   deps   — install production + dev deps (needed for build)
#   build  — compile TypeScript via `nest build`
#   runner — minimal runtime image, no dev deps, no source

# ── Stage 1: deps ─────────────────────────────────────────────────────────────
FROM node:20-slim AS deps

# Enable corepack so pnpm is available (pinned to the corepack-bundled version)
RUN corepack enable

WORKDIR /app

# Copy workspace manifests first (cache layer: only invalidated when lockfile changes)
COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY package.json ./

# Copy package.json files for all workspace packages (needed for pnpm filter graph)
COPY packages/core/package.json       ./packages/core/package.json
COPY packages/shared/package.json     ./packages/shared/package.json
COPY packages/cli/package.json        ./packages/cli/package.json
COPY packages/telegram/package.json   ./packages/telegram/package.json
COPY packages/web-ui/package.json     ./packages/web-ui/package.json

# Install all deps (dev included — needed for nest build in next stage)
RUN pnpm install --frozen-lockfile --filter=@orch/core...

# ── Stage 2: build ────────────────────────────────────────────────────────────
FROM deps AS build

WORKDIR /app

# Copy full source (build context = repo root)
COPY packages/core/src         ./packages/core/src
COPY packages/core/tsconfig.json ./packages/core/tsconfig.json
COPY packages/core/tsconfig.build.json ./packages/core/tsconfig.build.json
COPY packages/core/nest-cli.json ./packages/core/nest-cli.json
COPY packages/core/prisma      ./packages/core/prisma
COPY packages/shared/src       ./packages/shared/src
COPY packages/shared/tsconfig.json ./packages/shared/tsconfig.json

# Generate Prisma client before building
RUN pnpm --filter=@orch/core exec prisma generate

# Compile TypeScript
RUN pnpm --filter=@orch/core run build

# ── Stage 3: runner ───────────────────────────────────────────────────────────
FROM node:20-slim AS runner

# Install curl for the HEALTHCHECK command
RUN apt-get update && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app

# Copy workspace manifests
COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY package.json ./
COPY packages/core/package.json       ./packages/core/package.json
COPY packages/shared/package.json     ./packages/shared/package.json
COPY packages/cli/package.json        ./packages/cli/package.json
COPY packages/telegram/package.json   ./packages/telegram/package.json
COPY packages/web-ui/package.json     ./packages/web-ui/package.json

# Production deps only
RUN pnpm install --frozen-lockfile --prod --filter=@orch/core...

# Copy compiled output from build stage
COPY --from=build /app/packages/core/dist ./packages/core/dist
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
# Copy Prisma generated client + schema (needed at runtime)
COPY --from=build /app/packages/core/prisma ./packages/core/prisma
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma

EXPOSE 4141

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
  CMD curl -f http://localhost:4141/healthz || exit 1

CMD ["node", "packages/core/dist/main.js"]
