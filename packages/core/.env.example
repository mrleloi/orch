# Orch daemon environment configuration
# Copy to .env.local and fill in your values.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite database path (relative to packages/core/ or absolute).
# Prisma prepends "file:" automatically.
DATABASE_URL="file:./prisma/dev.db"

# ── HTTP server ───────────────────────────────────────────────────────────────
# Port to listen on.
PORT=3000

# Bind address. Default: 127.0.0.1 (localhost-only, per I-7).
# Set to 0.0.0.0 only if you need remote access (e.g. inside Docker).
ORCH_HTTP_HOST=127.0.0.1

# ── Hook receiver security ─────────────────────────────────────────────────────
# Shared secret for authenticating Claude Code hook POSTs.
# Set the same value in your Claude Code hooks configuration:
#   ORCH_HOOK_SECRET=<your-secret>  in the hook env
# Required — hooks are rejected with 401 if this is unset.
ORCH_HOOK_SECRET=change-me-before-use

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# OTLP HTTP trace exporter endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Service name reported to the OTEL collector.
OTEL_SERVICE_NAME=orch
