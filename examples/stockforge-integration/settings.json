{
  "_comment": "Paste the contents of the 'hooks' object below into <stockforge>/.claude/settings.json under the top-level 'hooks' key. Preserve any existing hooks already in that file. These four entries are the canonical Orch hook shape (Task 4.5 orch-receiver.sh pattern).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/orch-receiver.sh\" SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/orch-receiver.sh\" Stop"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/orch-receiver.sh\" SubagentStop"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/orch-receiver.sh\" PostToolUse"
          }
        ]
      }
    ]
  }
}
